flowchart TB
  subgraph IN["INPUT"]
    direction LR
    R["Request"] --> G["pre_request"] --> M["pre_model"]
  end
  subgraph TEAM["TEAM"]
    direction LR
    D["Director"] --> L["Team lead"] --> W["Worker"]
  end
  subgraph TOOL["EVERY TOOL CALL"]
    direction LR
    T["pre_tool"] --> C{"COMMIT?"}
    C -->|yes| A["One-shot approval<br/>server-side amount"]
    A --> S["Sandbox runner"]
    C -->|no| S
  end
  subgraph OUT["OUTPUT · MASKED"]
    direction LR
    P["post_tool"] --> O["pre_response"] --> V["Response · trace"]
  end
  IN --> TEAM
  TEAM --> TOOL
  TOOL --> OUT


  classDef infra fill:#26313d,stroke:#a1afbf,color:#e6edf6
  classDef result fill:#1a2837,stroke:#78d5ef,color:#e6edf6
  class R api
  class G,M,T,P,O guard
  class C,A control
  class S infra
  class V result

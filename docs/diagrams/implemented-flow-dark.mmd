flowchart TB
  subgraph IN["1 · BEFORE THE MODEL"]
    direction LR
    R["Request"] --> G["pre_request<br/>request gate"]
    G --> M["pre_model<br/>contracts · source · taint"]
  end
  subgraph TOOL["2 · BEFORE A TOOL RUNS"]
    direction LR
    T["pre_tool<br/>limits · policy"] --> C{"COMMIT?"}
    C -->|yes| A["Bound one-shot<br/>approval"]
    A --> S["Direct tool or<br/>Fake sandbox"]
    C -->|no| S
  end
  subgraph OUT["3 · BEFORE ANYTHING LEAVES"]
    direction LR
    P["post_tool<br/>masking · source · taint"] --> O["pre_response<br/>masking"]
    O --> V["Masked trace<br/>playground"]
  end
  IN --> TOOL
  TOOL --> OUT


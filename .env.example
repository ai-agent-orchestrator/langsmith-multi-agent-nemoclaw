# LangSmith (트레이싱을 켤 때만 필요)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travel-planner
# self-hosted / 사내 LangSmith 를 쓰면 엔드포인트 지정
# LANGSMITH_ENDPOINT=https://langsmith.internal.example.com

# off | masked | closed   (기본 masked)
#  off    : 마스킹 없이 전송 (개발용)
#  masked : 민감정보를 로컬에서 치환한 뒤 전송
#  closed : 트레이싱 완전 차단 (폐쇄망)
TRAVEL_SECURITY_MODE=masked

# ---- orchestra core
ORCHESTRA_ORG=travel_payment
ORCHESTRA_DOMAINS=travel,payment
ORCHESTRA_AGENT_BACKEND=prebuilt            # prebuilt | v1
ORCHESTRA_SECURITY_MODE=masked              # off|masked|closed|self_hosted (TRAVEL_SECURITY_MODE도 인식)
ORCHESTRA_WORKSPACE=                        # Claude dev 읽기 툴 루트. 절대경로만(워커 이미지는 /sandbox/workspace)
ORCHESTRA_FILTERS_OVERRIDE=
ORCHESTRA_SKILL_MAX_CHARS=20000
ORCHESTRA_PRICE_TABLE=                      # {"model-id": {"in": 0.0, "out": 0.0}} per 1M tokens

# ---- models (값은 사용 환경에서 확인해 채울 것)
ORCHESTRA_MODEL_PROVIDER=anthropic          # anthropic | openai_compatible | scripted
ORCHESTRA_MODEL_HAIKU=
ORCHESTRA_MODEL_SONNET=
ORCHESTRA_MODEL_OPUS=
ORCHESTRA_MODEL_LOCAL=                      # 예: Nemotron (NIM/vLLM/Ollama)
ORCHESTRA_LOCAL_BASE_URL=
ORCHESTRA_PRIVACY_ROUTE=local_first         # local_first | frontier_only | off
ANTHROPIC_API_KEY=

# ---- payment
PAYMENT_PROVIDER=mock                       # mock | <adapter>
PAYMENT_PROVIDER_HOST=
PAYMENT_MAX_KRW=1000000
PAYMENT_APPROVAL_KRW=0

# 긴급 중지: ORCHESTRA_KILL_SWITCH=1, 또는 실행 중에 걸려면 시작 전에 중지 파일의 절대경로를 지정.
# 그 경로에 무엇이든 있으면 새 모델·툴 호출을 막는다. 상위 디렉터리가 없거나 확인할 수 없어도 막는다.
ORCHESTRA_KILL_SWITCH=0
ORCHESTRA_KILL_SWITCH_FILE=

# ---- sandbox / NemoClaw
ORCHESTRA_SANDBOX=off                       # off | fake | nemoclaw | nemoclaw-full
NEMOCLAW_BIN=nemoclaw
OPENSHELL_BIN=openshell
NEMOCLAW_SANDBOX_CODE=orchestra-code
NEMOCLAW_SANDBOX_PAYMENTS=orchestra-payments
NEMOCLAW_INFERENCE_BASE_URL=                # 샌드박스 내부 추론 경로 (설치 환경에서 확인)
NEMOCLAW_TRANSPORT=stdio_via_cli            # stdio_via_cli (호출마다 exec) | ssh_stream (워커 상시 실행, 실설치 확인 후)
ORCHESTRA_CAPABILITY_KEY_FILE=              # 호스트 마스터 키 파일(32바이트 이상). 샌드박스에는 파생 키만 전달
SSH_BIN=ssh                                 # ssh_stream 이 쓰는 OpenSSH 클라이언트
NEMOCLAW_DISABLE_TELEMETRY=1

# ---- claude CLI (exec=cli)
CLAUDE_BIN=claude
CLAUDE_PLUGINS_DIR=third_party/claude_plugins/plugins

# Approval binding lifetime; expiry is not renewed on interrupt resume.
ORCHESTRA_APPROVAL_TTL_SECONDS=300

# C22: process memory by default; SQLite requires an explicit path and env-only secret.
# Example: ORCHESTRA_LEDGER=sqlite:///C:/private/orchestra/ledger.db (directory must exist).
ORCHESTRA_LEDGER=memory
# Set a random secret of at least 32 UTF-8 bytes outside this file when SQLite is enabled.
ORCHESTRA_LEDGER_HMAC_KEY=
# Optional public rotation label; blank derives a non-secret HMAC key identifier.
ORCHESTRA_LEDGER_KEY_ID=
